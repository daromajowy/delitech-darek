Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteCond %{HTTP_HOST} !^(www\.)?intelispaces\.pl$ [NC]
RewriteRule ^ - [L]
RewriteCond %{HTTP_HOST} ^www\.intelispaces\.pl$ [NC]
RewriteRule ^ https://intelispaces.pl%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://intelispaces.pl%{REQUEST_URI} [R=301,L]
RewriteRule ^(?:knx-app|\.knx-laravel|\.intelispaces-private)(?:/|$) - [F,L]
RewriteRule ^knx/app(?:/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^projektant-knx(?:/(.*))?$ https://knx.intelispaces.pl/$1 [R=308,L]
RewriteRule ^wordpress(?:/(.*))?$ /$1 [R=301,L]
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^(?:wp-admin(?:/.*)?|wp-login\.php)$ https://knx.intelispaces.pl/admin [R=302,L]
RewriteRule ^(?:wp-json|wp-includes|xmlrpc\.php)(?:/|$) - [G,L]
RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/([\w.-]+)$ /media/$1 [R=301,L]
RewriteRule ^wp-content(?:/|$) - [G,L]
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
