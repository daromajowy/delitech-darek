AddHandler application/x-httpd-php84 php
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
# Canonical HTTPS address, covered by the domain certificate.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^intelispaces\.pl$ [NC]
RewriteRule ^ https://intelispaces.pl%{REQUEST_URI} [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^studio(?:/.*)?$ /studio/index.html [L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
# Keep the migration preview out of search until CMS activation and company details are confirmed.
Header set X-Robots-Tag "noindex, nofollow"
<FilesMatch "^(index\.html|cms-config\.json)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
